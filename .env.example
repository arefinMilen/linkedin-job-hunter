# ─── Gemini API ────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Apify (LinkedIn Scraper) ─────────────────────────────
APIFY_API_TOKEN=your_apify_api_token_here

# ─── Telegram Bot ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ─── Job Search Config ────────────────────────────────────
# Comma-separated search queries
SEARCH_QUERIES=remote software engineer,remote frontend developer,remote fullstack developer,remote next.js developer
# Minimum match score (0–100) to trigger a Telegram alert
MATCH_THRESHOLD=75
# Maximum number of jobs to scrape per query
MAX_JOBS_PER_QUERY=25
# Geographic filter (leave blank for worldwide)
LOCATION=
